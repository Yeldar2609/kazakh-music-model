# Copy to .env.local and adjust. Scripts default to project-relative paths when unset.
# Weights (~6.3 GB). Keep OUTSIDE synced folders such as OneDrive.
KMM_CHECKPOINTS=C:\kmm\checkpoints
# uv virtual environment for upstream/ACE-Step-1.5 (recreate per machine, never copy)
UV_PROJECT_ENVIRONMENT=C:\kmm\venv-acestep
# Preprocessed tensors and training outputs (large, machine-local)
KMM_WORK=C:\kmm\work
# Force UTF-8 so Kazakh Cyrillic survives Windows default code pages
PYTHONUTF8=1
